# Copy this file to .env and fill it in. Never commit .env: it holds your passwords.
# setup.sh and run.sh load it automatically.

# Postgres connections, with the passwords you chose while running migrations/db_setup.sql.
# The app uses widgetbot_app (rows only); migrations use widgetbot (owns the tables).
DATABASE_URL=postgresql://widgetbot_app:CHANGE_ME@localhost:5432/widgetbot
MIGRATIONS_DATABASE_URL=postgresql://widgetbot:CHANGE_ME_TOO@localhost:5432/widgetbot

# Groq API key for AI replies and chat summaries: https://console.groq.com/
GROQ_API_KEY=

# The login cookie is only sent over HTTPS. Browsers allow it on http://localhost and http://127.0.0.1 too;
# set 0 only to test over plain http on another address. Never 0 in production.
COOKIE_SECURE=1

# The address people reach the app at (scheme + host, no trailing slash). Links in lead emails use it, and
# requests addressed to any other host name are refused. For a local test: http://127.0.0.1:8000
PUBLIC_BASE_URL=https://bot.example.com
# Extra host names to accept, comma-separated (e.g. localhost while testing)
# ALLOWED_HOSTS=

# Where run.sh listens. Put a reverse proxy (nginx, Caddy) with HTTPS in front of it in production.
HOST=127.0.0.1
PORT=8000

# The crawler is a real browser on this server, so it must reach the web through a proxy that refuses
# private and internal addresses (otherwise a crawled page could read services on this machine or network).
# Crawling is turned off until this is set. See "Crawler proxy" in README.md.
CRAWLER_PROXY_URL=http://127.0.0.1:4750
# Local development only: crawl without the proxy. Never set this on a server.
# CRAWLER_ALLOW_DIRECT=1

# --- Optional ---

# Only needed if the database holds more than one client
# DEFAULT_CLIENT_SLUG=

# A cheaper Groq model for chat summaries; defaults to the chat model
# ANALYSIS_MODEL=

# Most AI replies one client's widget may send per 24 hours, whoever is asking (FAQ answers don't count).
# Protects the Groq budget if the public widget key is abused. 0 = no cap.
# MAX_DAILY_AI_REPLIES_PER_CLIENT=2000

# Minutes a chat must be idle before it is summarised
# ANALYSIS_IDLE_MINUTES=30

# Lead alert emails; skipped until SMTP_HOST is set. Port 465 uses SSL, any other port STARTTLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
