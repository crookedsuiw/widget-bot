# Copy this file to .env and fill it in. Never commit .env: it holds your passwords.
# setup.sh and run.sh load it automatically.

# Postgres connection. The password is the one you chose while running migrations/db_setup.sql.
DATABASE_URL=postgresql://widgetbot:CHANGE_ME@localhost:5432/widgetbot

# Groq API key for AI replies and chat summaries: https://console.groq.com/
GROQ_API_KEY=

# Set to 1 once the app is served over HTTPS (required in production)
COOKIE_SECURE=0

# Where run.sh listens. Put a reverse proxy (nginx, Caddy) with HTTPS in front of it in production.
HOST=127.0.0.1
PORT=8000

# --- Optional ---

# Only needed if the database holds more than one client
# DEFAULT_CLIENT_SLUG=

# A cheaper Groq model for chat summaries; defaults to the chat model
# ANALYSIS_MODEL=

# Minutes a chat must be idle before it is summarised
# ANALYSIS_IDLE_MINUTES=30

# Lead alert emails; skipped until SMTP_HOST is set. Port 465 uses SSL, any other port STARTTLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
